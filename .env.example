# Copy this file to .env and fill in real values. Never commit .env itself.

# A long random string in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-key-change-me

# Defaults to a local SQLite file at instance/ois.db if unset.
# DATABASE_URL=postgresql://user:password@localhost:5432/ois

# Leave MAIL_SERVER unset to run locally without sending real email —
# inquiries still save to the database either way.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=

# Where new-inquiry notification emails are sent.
ADMIN_EMAIL=office@hhskole.dk
